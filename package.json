{
  "name": "codex-usage",
  "displayName": "Codex Usage",
  "description": "Show Codex usage and spend-limit status in the VS Code status bar.",
  "version": "0.1.3",
  "publisher": "JackCarruthers-Vix",
  "license": "MIT",
  "icon": "images/usage-gauge-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/jcarruthers-vix/vscode-codex-usage-checker.git"
  },
  "homepage": "https://github.com/jcarruthers-vix/vscode-codex-usage-checker#readme",
  "bugs": {
    "url": "https://github.com/jcarruthers-vix/vscode-codex-usage-checker/issues"
  },
  "keywords": [
    "codex",
    "usage",
    "quota",
    "spend limit",
    "rate limit",
    "status bar"
  ],
  "galleryBanner": {
    "color": "#101827",
    "theme": "dark"
  },
  "pricing": "Free",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:codexUsage.refresh"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codexUsage.refresh",
        "title": "Codex Usage: Refresh"
      }
    ],
    "configuration": {
      "title": "Codex Usage",
      "properties": {
        "codexUsage.accountDirectory": {
          "type": "string",
          "default": "~/.codex",
          "description": "Directory containing the Codex auth file."
        },
        "codexUsage.accountName": {
          "type": "string",
          "default": "",
          "description": "Optional account name. Loads <accountName>.auth.json instead of auth.json."
        },
        "codexUsage.dateLocale": {
          "type": "string",
          "default": "",
          "examples": [
            "en-AU",
            "en-US",
            "de-DE"
          ],
          "description": "Optional BCP 47 locale for dates, such as en-AU. When empty, the VS Code display language is used."
        },
        "codexUsage.refreshIntervalMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "description": "Automatic refresh interval in minutes. Set to 0 to disable automatic refresh."
        },
        "codexUsage.requestTimeoutSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "maximum": 120,
          "description": "Timeout for usage API requests."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.7.0"
  }
}
